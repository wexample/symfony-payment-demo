{
  "name": "wexample/symfony-payment-demo",
  "version": "2.0.1",
  "type": "library",
  "license": "MIT",
  "description": "A demo of symfony-payment-ds: an item bought, a provider pretended, every case of a payment played",
  "autoload": {
    "psr-4": {
      "Wexample\\SymfonyPaymentDemo\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Wexample\\SymfonyPaymentDemo\\Tests\\": "tests/"
    }
  },
  "authors": [
    {
      "name": "weeger",
      "email": "romain.weeger@wexample.com"
    }
  ],
  "require": {
    "php": ">=8.5",
    "wexample/symfony-helpers": ">=16.0.0",
    "wexample/symfony-loader": ">=23.0.0",
    "wexample/symfony-design-system": ">=35.0.0",
    "wexample/symfony-payment": ">=4.0.0",
    "wexample/symfony-payment-ds": ">=2.0.0",
    "wexample/symfony-remote-payment": ">=3.0.0",
    "wexample/symfony-user": ">=12.0.0",
    "wexample/symfony-user-demo": ">=6.0.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^13"
  },
  "repositories": [
    {
      "type": "path",
      "url": "../*",
      "options": {
        "symlink": true
      }
    }
  ],
  "extra": {
    "install": {
      "bundle_env": "all"
    }
  }
}